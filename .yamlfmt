formatter:
  type: basic
  indent: 2
  include_document_start: false
  indentless_arrays: false
  eof_newline: true
  retain_line_breaks: true
  scan_folded_as_literal: true
  pad_line_comments: 2

# File selection belongs to scripts/normalize_yaml_flow.py and is shared by
# make yaml-fmt, yaml-fmt-check and yaml-lint. This config only formats stdin.
